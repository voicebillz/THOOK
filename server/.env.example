# --- Railway variables for the THOOK server ---
# Owner wallet that logs in to thook.vip/admin (only this wallet gets in).
ADMIN_WALLET=0x1C7768ABcD47cf0427dDc5C5DBF0F9a7Ff621325
# Keeper wallet: deploys the launch from /admin, then may ONLY call vault.payEpoch(). Fund ~0.01 ETH.
KEEPER_KEY=
# Turn on automatic weekly payouts once you've checked a preview in /admin.
KEEPER_ENABLED=false
# Claude API key for the prize auditor agent.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Railway Postgres (reference variable)
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Prize rules
MIN_HOLD_THOOK=100000
TOP_N=1
PAYOUT_BPS=10000
RANK_BY=usd
# Website origin (set to your domain when you have it)
CORS_ORIGIN=https://thook.vip
# Extra addresses that can never win (CEX wallets etc.), comma separated
EXCLUDE=
# Safe that owns the fee vault from deploy (withdraw, limits, keeper, pause)
SAFE_ADDRESS=0x0FAA730e822622fd804A20140bC8bb299caF1db8
# Admin login signatures are bound to this domain
ADMIN_DOMAIN=thook.vip
